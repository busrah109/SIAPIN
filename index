<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Kearsipan & Administrasi BAP Pemasyarakatan Pro</title>

    <!-- FIREBASE SDK (CDN STANDALONE) -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }
        body {
            background-color: #f1f5f9;
            margin: 0;
            padding: 0;
            color: #1e293b;
        }

        /* HALAMAN LOGIN */
        #login-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #0f172a;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }
        .login-box {
            background: #ffffff;
            padding: 30px;
            border-radius: 8px;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            text-align: center;
        }
        .login-box h2 {
            margin-top: 0;
            color: #0f172a;
            font-size: 20px;
            border-bottom: 2px solid #cbd5e1;
            padding-bottom: 10px;
        }
        .login-box .form-group {
            text-align: left;
            margin-bottom: 15px;
        }
        .login-box input {
            width: 100%;
            padding: 10px;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            font-size: 14px;
        }
        .login-error {
            color: #ef4444;
            font-size: 12px;
            margin-top: 10px;
            display: none;
        }

        /* Status Badge Online Cloud */
        .cloud-badge {
            font-size: 11px;
            padding: 3px 8px;
            border-radius: 12px;
            background-color: #10b981;
            color: #fff;
            margin-left: 8px;
            font-weight: normal;
        }

        /* Navigation & Header */
        .app-header {
            background-color: #0f172a;
            color: #ffffff;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
            flex-wrap: wrap;
            gap: 10px;
        }
        .app-header h1 {
            margin: 0;
            font-size: 18px;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
        }
        .nav-tabs {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .tab-btn {
            background-color: #1e293b;
            color: #94a3b8;
            border: 1px solid #334155;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            transition: all 0.2s;
        }
        .tab-btn:hover, .tab-btn.active {
            background-color: #2563eb;
            color: #ffffff;
            border-color: #2563eb;
        }

        .container {
            max-width: 1000px;
            margin: 25px auto;
            background: #ffffff;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        h2, h3 {
            color: #0f172a;
            border-bottom: 2px solid #cbd5e1;
            padding-bottom: 6px;
            margin-top: 25px;
        }
        .form-group {
            margin-bottom: 12px;
        }
        .form-row {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }
        .form-row .form-group {
            flex: 1;
            min-width: 200px;
        }
        label {
            display: block;
            font-weight: 600;
            margin-bottom: 4px;
            font-size: 13px;
        }
        input, textarea, select {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            font-size: 13px;
            font-family: Arial, sans-serif;
        }
        textarea {
            resize: vertical;
            height: 70px;
        }
        
        .btn {
            background-color: #1d4ed8;
            color: white;
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn:hover { background-color: #1e40af; }
        .btn-danger { background-color: #ef4444; }
        .btn-danger:hover { background-color: #dc2626; }
        .btn-secondary { background-color: #64748b; }
        .btn-secondary:hover { background-color: #475569; }
        .btn-success { background-color: #15803d; }
        .btn-success:hover { background-color: #166534; }
        .btn-word { background-color: #2b579a; }
        .btn-word:hover { background-color: #1e3e6d; }

        .dynamic-item {
            background: #f8fafc;
            padding: 12px;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            margin-bottom: 10px;
            position: relative;
        }
        .dynamic-item .btn-danger {
            position: absolute;
            top: 8px;
            right: 8px;
            padding: 3px 8px;
            font-size: 11px;
        }

        /* Tabel Arsip Data */
        .search-bar {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .search-bar input[type="text"] {
            flex: 1;
            min-width: 200px;
        }
        .table-responsive {
            overflow-x: auto;
        }
        .archive-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        .archive-table th, .archive-table td {
            border: 1px solid #e2e8f0;
            padding: 10px 12px;
            text-align: left;
            font-size: 13px;
        }
        .archive-table th {
            background-color: #f8fafc;
            font-weight: 600;
        }
        .archive-table tr:hover {
            background-color: #f1f5f9;
        }

        /* FORMAT CETAK DOKUMEN RESMI BAP */
        #bap-preview {
            display: none;
            background: #fff;
            padding: 20px;
            font-family: Arial, sans-serif;
            color: #000;
            line-height: 1.35;
            font-size: 11pt;
        }

        .kop-surat-wrapper {
            display: flex;
            align-items: center;
            border-bottom: 3px double #000;
            padding-bottom: 6px;
            margin-bottom: 15px;
        }
        .kop-logo {
            width: 80px;
            height: 80px;
            margin-right: 15px;
            object-fit: contain;
        }
